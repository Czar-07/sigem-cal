# ============================================================
# SIGEM CAL — CONFIGURAÇÃO DE PRODUÇÃO
# ============================================================
FLASK_ENV=production

# Gere com: python scripts/security.py
SECRET_KEY=COLE_AQUI_UMA_CHAVE_ALEATORIA_FORTE
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=COLE_AQUI_O_HASH_GERADO

# Banco
DATABASE_URL=sqlite:///instance/sigem.db

# Excel
EXCEL_PATH=excel/Controle Calibração de Dispositivos 2026 REV1.xlsx

# Armazenamento
UPLOAD_FOLDER=uploads
CERTIFICATES_FOLDER=certificados

# Sessão
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=28800

# Upload
MAX_CONTENT_LENGTH=20971520

# SMTP (opcional)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
